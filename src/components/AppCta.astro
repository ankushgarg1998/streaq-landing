---
// Primary call to action. Streaq is generally available on two surfaces, so
// this is a pair of links, not a form: the Android app on Google Play (primary)
// and the web app (secondary ghost button). No client JS, no third-party
// request: the Play badge is Google's official artwork, served from public/
// rather than hotlinked from play.google.com.
// Inline row on desktop; stacked full-width inside .layout-mobile.
interface Props {
  playHref?: string;
  playCta?: string;
  webHref?: string;
  webCta?: string;
}
const {
  playHref = 'https://play.google.com/store/apps/details?id=club.streaq.app',
  playCta = 'Get it on Google Play',
  webHref = 'https://app.streaq.club',
  webCta = 'Open in browser',
} = Astro.props;
---

<div class="cta">
  <div class="cta-row">
    <!-- Google's official badge, unmodified. The PNG's transparent border is
         the required clear space, so it is never cropped; the artwork is black
         with a white outline, which reads on both the cream and ink pages. -->
    <a class="cta-badge" href={playHref}>
      <img src="/google-play-badge.png" alt={playCta} width="646" height="250" />
    </a>

    <a class="cta-btn cta-btn--ghost" href={webHref}>
      {webCta}
      <svg
        class="cta-arrow"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="18" y2="12"></line>
        <polyline points="12,6 18,12 12,18"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .cta {
    max-width: 560px;
    width: 100%;
  }

  /* ── desktop: two inline pills, centered under the hero ── */
  .cta-row {
    /* Badge height; the ghost button's width is derived from it below. */
    --badge-h: 84px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 16px;
    padding: 17px 28px;
    border-radius: 14px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      opacity 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }
  /* Play badge: the PNG is 646x250 with 41px of transparent clear space on
     every side, so the artwork is 66.8% of the rendered height; 84px here
     puts it at the ghost button's 56px. Height only, so the ratio is kept. */
  .cta-badge {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 160ms ease;
  }
  .cta-badge:hover {
    opacity: 0.88;
  }
  .cta-badge img {
    display: block;
    height: var(--badge-h);
    width: auto;
  }
  /* Same width as the badge's visible artwork: 564 of the PNG's 646px width
     is artwork (41px clear space each side), at 250px tall. */
  .cta-btn--ghost {
    justify-content: center;
    /* Width and height both match the badge artwork (564x168 of 646x250). */
    width: calc(var(--badge-h) * 564 / 250);
    height: calc(var(--badge-h) * 168 / 250);
    padding: 0;
    background: transparent;
    color: var(--sub);
    border-color: var(--field-border);
  }
  .cta-btn--ghost:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
  .cta-btn--ghost:hover .cta-arrow {
    transform: translateX(2px);
  }
  .cta-arrow {
    flex-shrink: 0;
    transition: transform 160ms ease;
  }
  /* ── mobile: stacked, centred buttons of equal width ── */
  :global(.layout-mobile) .cta {
    max-width: 100%;
  }
  :global(.layout-mobile) .cta-row {
    --badge-h: 76px;
    flex-direction: column;
    align-items: center;
    /* The badge brings ~15px of its own clear space below the artwork. */
    gap: 4px;
  }
  :global(.layout-mobile) .cta-btn {
    font-size: 15px;
    border-radius: 12px;
  }
</style>
