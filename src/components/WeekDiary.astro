---
// "Show me your last week's diary": a working copy of the app's Week screen
// (proj2/app/src/features/week: WeekScreen header, WeekDateBar,
// HabitWeekCard, DayBox, and the TabBar). On desktop it sits in a phone
// frame with the app's header and tab bar; on phones the frame drops away
// and only the cards remain, since the page is already on a phone.
// Tap a day to check it off or clear it; the tallies follow. On load the
// done days fill in one day at a time, the page's only unprompted motion,
// skipped under prefers-reduced-motion.
const DAYS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const NAMES = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const HABITS: { name: string; emoji: string; hue: number; week: number[] }[] = [
  // Most ambitious first.
  { name: 'Deep work, 2 hrs', emoji: '🧠', hue: 300, week: [1, 1, 0, 1, 1, 0, 0] },
  { name: 'Learn Spanish', emoji: '🗣️', hue: 340, week: [0, 1, 0, 1, 0, 1, 0] },
  { name: 'Workout', emoji: '💪', hue: 162, week: [1, 0, 1, 0, 1, 0, 0] },
  { name: 'Read 20 pages', emoji: '📖', hue: 42, week: [1, 1, 0, 1, 1, 1, 1] },
  { name: 'Sleep by 11', emoji: '🌙', hue: 220, week: [1, 1, 1, 0, 0, 0, 1] },
];
const TOTAL = HABITS.length * 7;
const DONE = HABITS.reduce((n, h) => n + h.week.reduce((a, b) => a + b, 0), 0);
const fill = (h: number) => `oklch(0.78 0.09 ${h})`;
const deep = (h: number) => `oklch(0.58 0.11 ${h})`;
const CHECK =
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><polyline points="4.5,12.8 9.6,18 19.5,6.4" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const TABS = ['Week', 'Month', 'New', 'Friends', 'You'];
---

<figure class="week" aria-label="An example week in Streaq. Tap a day to check it off.">
  <div class="phone">
    <div class="screen">
      <div class="status" aria-hidden="true">
        <span>9:41</span>
        <svg width="54" height="12" viewBox="0 0 54 12" fill="currentColor">
          <rect x="0" y="7" width="3" height="5" rx="1"></rect>
          <rect x="5" y="5" width="3" height="7" rx="1"></rect>
          <rect x="10" y="2.5" width="3" height="9.5" rx="1"></rect>
          <rect x="15" y="0" width="3" height="12" rx="1"></rect>
          <rect x="27" y="0.5" width="22" height="11" rx="3.5" fill="none" stroke="currentColor" opacity="0.4"></rect>
          <rect x="29" y="2.5" width="16" height="7" rx="2"></rect>
          <rect x="50.5" y="4" width="2" height="4" rx="1" opacity="0.4"></rect>
        </svg>
      </div>

      <div class="scroll">
        <div class="apphead" aria-hidden="true">
          <div class="kicker" data-range></div>
          <div class="title">Last week</div>
          <div class="progress">
            <span class="kicker"><span data-done-total>{DONE}</span>/{TOTAL} done</span>
            <span class="track"><span class="bar" style={`width:${(DONE / TOTAL) * 100}%`}></span></span>
          </div>
        </div>

        <div class="datebar" aria-hidden="true">
          {
            DAYS.map((d, i) => (
              <div class="col" data-weekend={i >= 5}>
                <div class="dow">{d}</div>
                <div class="date" data-date-index={i} />
              </div>
            ))
          }
        </div>

        <div class="cards">
          {
            HABITS.map((h) => (
              <div class="card" data-card>
                <div class="head">
                  <span class="emoji" aria-hidden="true">
                    {h.emoji}
                  </span>
                  <span class="name">{h.name}</span>
                  <span class="tally" data-tally>
                    {h.week.reduce((a, b) => a + b, 0)}/7
                  </span>
                </div>
                <div class="days">
                  {h.week.map((on, i) => (
                    <button
                      type="button"
                      class:list={['box', on && 'seed']}
                      style={`--fill:${fill(h.hue)}; --deep:${deep(h.hue)}; --col:${i};`}
                      data-done={on ? 'true' : 'false'}
                      data-weekend={i >= 5}
                      data-letter={DAYS[i]}
                      aria-pressed={on ? 'true' : 'false'}
                      aria-label={`${h.name}, ${NAMES[i]}`}
                    >
                      {on ? <Fragment set:html={CHECK} /> : <span class="letter">{DAYS[i]}</span>}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="tabs" aria-hidden="true">
        {
          TABS.map((t, i) => (
            <span class="tab" data-active={i === 0}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                {i === 0 && (
                  <Fragment>
                    <rect x="3.5" y="3.5" width="6" height="6" rx="1.5" fill="currentColor" />
                    <rect x="14.5" y="3.5" width="6" height="6" rx="1.5" />
                    <rect x="3.5" y="14.5" width="6" height="6" rx="1.5" />
                    <rect x="14.5" y="14.5" width="6" height="6" rx="1.5" fill="currentColor" />
                  </Fragment>
                )}
                {i === 1 && (
                  <Fragment>
                    <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
                    <path d="M8 3.5v4 M16 3.5v4 M3.5 10.5h17" />
                  </Fragment>
                )}
                {i === 2 && (
                  <Fragment>
                    <circle cx="12" cy="12" r="8.5" />
                    <path d="M12 8v8 M8 12h8" />
                  </Fragment>
                )}
                {i === 3 && (
                  <Fragment>
                    <circle cx="9" cy="9" r="3.2" />
                    <circle cx="16.5" cy="10" r="2.4" />
                    <path d="M3 19c1-3 3.5-4.3 6-4.3s5 1.3 6 4.3" />
                    <path d="M15 18c.7-2 2.3-3 4-3s2.8.5 3.5 1.6" />
                  </Fragment>
                )}
                {i === 4 && (
                  <Fragment>
                    <circle cx="12" cy="9" r="3.5" />
                    <path d="M4.5 20c1.5-4 4.5-5.5 7.5-5.5s6 1.5 7.5 5.5" />
                  </Fragment>
                )}
              </svg>
              <span class="tab-label">{t}</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
  <figcaption>Tap a day to check it off.</figcaption>
</figure>

<script define:vars={{ CHECK, TOTAL }}>
  const root = document.querySelector('.week');
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  // Last week, Monday to Sunday, so the diary is always "last week".
  const now = new Date();
  const monday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  monday.setDate(monday.getDate() - ((monday.getDay() + 6) % 7) - 7);
  const day = (i) => {
    const d = new Date(monday);
    d.setDate(monday.getDate() + i);
    return d;
  };
  root.querySelectorAll('[data-date-index]').forEach((el) => {
    el.textContent = String(day(Number(el.getAttribute('data-date-index'))).getDate());
  });

  // Header kicker, as the app writes it: "Oct 12 to 18 · week 42".
  const start = day(0);
  const end = day(6);
  const thursday = day(3);
  const jan4 = new Date(thursday.getFullYear(), 0, 4);
  const week = 1 + Math.round(((thursday - jan4) / 86400000 - 3 + ((jan4.getDay() + 6) % 7)) / 7);
  const endLabel =
    start.getMonth() === end.getMonth() ? end.getDate() : `${MONTHS[end.getMonth()]} ${end.getDate()}`;
  root.querySelector('[data-range]').textContent =
    `${MONTHS[start.getMonth()]} ${start.getDate()} to ${endLabel} · week ${week}`;

  const doneTotal = root.querySelector('[data-done-total]');
  const bar = root.querySelector('.bar');

  root.querySelectorAll('.box').forEach((box) => {
    box.addEventListener('click', () => {
      const done = box.getAttribute('data-done') !== 'true';
      box.classList.remove('seed');
      box.setAttribute('data-done', String(done));
      box.setAttribute('aria-pressed', String(done));
      box.innerHTML = done
        ? CHECK
        : `<span class="letter">${box.getAttribute('data-letter')}</span>`;
      box.classList.remove('pulse');
      void box.offsetWidth; // restart the press animation
      box.classList.add('pulse');

      const card = box.closest('[data-card]');
      card.querySelector('[data-tally]').textContent =
        `${card.querySelectorAll('.box[data-done="true"]').length}/7`;
      const all = root.querySelectorAll('.box[data-done="true"]').length;
      doneTotal.textContent = String(all);
      bar.style.width = `${(all / TOTAL) * 100}%`;
    });
  });
</script>

<style>
  .week {
    margin: 0;
    --card-bg: #fffdf8;
    --hairline: rgb(26 24 21 / 8%);
    --box-bg: rgb(26 24 21 / 3.5%);
    --box-weekend: rgb(26 24 21 / 7.5%);
    --letter: rgb(26 24 21 / 32%);
    --tab: rgb(26 24 21 / 42%);
    --weekend: oklch(0.56 0.13 32);
    --bezel: #1a1815;
  }
  :global([data-theme='dark']) .week {
    --card-bg: rgb(255 255 255 / 3.5%);
    --hairline: rgb(255 255 255 / 8%);
    --box-bg: rgb(255 255 255 / 4.5%);
    --box-weekend: rgb(255 255 255 / 10%);
    --letter: rgb(237 234 227 / 38%);
    --tab: rgb(237 234 227 / 45%);
    --weekend: oklch(0.74 0.12 32);
    --bezel: #2a2622;
  }

  /* ── Phone frame (desktop). On phones it dissolves; see the media query. ── */
  .phone {
    width: 392px;
    margin: 0 auto;
    padding: 10px;
    border-radius: 52px;
    background: var(--bezel);
    box-shadow: 0 30px 60px -30px rgb(26 24 21 / 45%);
  }
  :global([data-theme='dark']) .phone {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
  }
  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 808px;
    border-radius: 42px;
    overflow: hidden;
    background: var(--page-bg);
  }
  .status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 30px 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
  }
  /* The app scrolls under a fixed tab bar; so does this. */
  .scroll {
    flex: 1;
    overflow-y: auto;
    padding: 0 16px 20px;
    scrollbar-width: none;
  }
  .scroll::-webkit-scrollbar {
    display: none;
  }

  /* App header: kicker, "Last week", progress. */
  .apphead {
    padding: 8px 4px 14px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--mute);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 38px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 4px 0 6px;
  }
  .progress {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .track {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: var(--hairline);
  }
  .bar {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--fg);
    transition: width 240ms ease;
  }

  .tabs {
    display: flex;
    justify-content: space-around;
    padding: 10px 6px 22px;
    border-top: 0.5px solid var(--hairline);
    background: var(--page-bg);
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: var(--tab);
  }
  .tab[data-active='true'] {
    color: var(--fg);
  }
  .tab-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── The Week view itself ── */
  /* Date bar grid matches a card's day grid (card padding 13px, gap 6px). */
  .datebar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    padding: 0 13px 8px;
  }
  .col {
    text-align: center;
    color: var(--mute);
  }
  .col[data-weekend='true'] {
    color: var(--weekend);
  }
  .dow {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
  }
  .date {
    margin-top: 2px;
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
    min-height: 20px;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card {
    padding: 13px 13px 14px;
    border: 0.5px solid var(--hairline);
    border-radius: 20px;
    background: var(--card-bg);
    box-shadow:
      0 1px 0 rgb(26 24 21 / 3%),
      0 8px 24px -14px rgb(26 24 21 / 10%);
  }
  :global([data-theme='dark']) .card {
    box-shadow: none;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .emoji {
    width: 20px;
    font-size: 16px;
    line-height: 1;
    text-align: center;
  }
  .name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tally {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }
  .days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-top: 11px;
  }

  /* One day: weekday letter when open, habit colour and a tick when done. */
  .box {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--box-bg);
    color: var(--deep);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background 160ms ease;
  }
  .box[data-weekend='true'] {
    background: var(--box-weekend);
  }
  .box[data-done='true'] {
    background: var(--fill);
  }
  .box:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .box :global(.letter) {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--letter);
  }

  figcaption {
    margin-top: 16px;
    font-size: 14px;
    color: var(--mute);
    text-align: center;
  }

  /* On a phone the page already is a phone: drop the frame, the status bar,
     the app header and the tab bar, and let the cards use the column. */
  @media (max-width: 720px) {
    .phone,
    .screen,
    .scroll {
      display: contents;
    }
    .status,
    .apphead,
    .tabs {
      display: none;
    }
    figcaption {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .box:global(.pulse) {
      animation: press 320ms ease;
    }
    @keyframes press {
      40% {
        transform: scale(0.86);
      }
    }
    .box:global(.seed) {
      animation: keep 420ms cubic-bezier(0.2, 0.9, 0.3, 1.25) both;
      animation-delay: calc(350ms + var(--col) * 110ms);
    }
    @keyframes keep {
      from {
        background: var(--box-bg);
        color: transparent;
        transform: scale(0.86);
      }
    }
  }
</style>
