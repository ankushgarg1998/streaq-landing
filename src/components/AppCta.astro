---
// Primary call to action. Streaq is generally available on two surfaces, so
// this is a pair of links, not a form: the Android app on Google Play (primary)
// and the web app (secondary ghost button). No client JS, no third-party
// request — the Play mark is inline SVG rather than Google's hosted badge, so
// it themes with the page and costs nothing to load.
// Inline row on desktop; stacked full-width inside .layout-mobile.
interface Props {
  playHref?: string;
  playCta?: string;
  webHref?: string;
  webCta?: string;
  note?: string;
}
const {
  playHref = 'https://play.google.com/store/apps/details?id=club.streaq.app',
  playCta = 'Get it on Google Play',
  webHref = 'https://app.streaq.club',
  webCta = 'Open in your browser',
  note = 'Same streaks on your phone and in your browser',
} = Astro.props;
---

<div class="cta">
  <div class="cta-row">
    <a class="cta-btn cta-btn--primary" href={playHref}>
      <!-- Google Play mark: left wing blue, top green, bottom amber, tip red. -->
      <svg
        class="cta-play"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M4 2 13.2 12 4 22Z" fill="#00A0FF"></path>
        <path d="M4 2 17.6 7.4 13.2 12Z" fill="#00E676"></path>
        <path d="M4 22 13.2 12 17.6 16.6Z" fill="#FFCE00"></path>
        <path d="M17.6 7.4 21.4 12 17.6 16.6 13.2 12Z" fill="#FF3A44"></path>
      </svg>
      {playCta}
    </a>

    <a class="cta-btn cta-btn--ghost" href={webHref}>
      {webCta}
      <svg
        class="cta-arrow"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="18" y2="12"></line>
        <polyline points="12,6 18,12 12,18"></polyline>
      </svg>
    </a>
  </div>
  <div class="cta-note">{note}</div>
</div>

<style>
  .cta {
    max-width: 560px;
    width: 100%;
  }

  /* ── desktop: two inline pills, centered under the hero ── */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 16px;
    padding: 17px 28px;
    border-radius: 14px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      opacity 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }
  .cta-btn--primary {
    background: var(--btn-bg);
    color: var(--btn-fg);
  }
  .cta-btn--primary:hover {
    opacity: 0.88;
  }
  .cta-btn--ghost {
    background: transparent;
    color: var(--sub);
    border-color: var(--field-border);
  }
  .cta-btn--ghost:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
  .cta-btn--ghost:hover .cta-arrow {
    transform: translateX(2px);
  }
  .cta-play,
  .cta-arrow {
    flex-shrink: 0;
  }
  .cta-arrow {
    transition: transform 160ms ease;
  }
  .cta-note {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--mute);
    letter-spacing: 0.04em;
    margin-top: 18px;
    text-transform: uppercase;
    text-align: center;
  }

  /* ── mobile: stacked full-width buttons, left-aligned note ── */
  :global(.layout-mobile) .cta {
    max-width: 100%;
  }
  :global(.layout-mobile) .cta-row {
    flex-direction: column;
    gap: 10px;
  }
  :global(.layout-mobile) .cta-btn {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 18px 22px;
    border-radius: 13px;
  }
  :global(.layout-mobile) .cta-note {
    text-align: left;
    padding-left: 4px;
    margin-top: 15px;
  }
</style>
