---
import '../styles/tokens.css';
import BrandLockup from '../components/BrandLockup.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Eyebrow from '../components/Eyebrow.astro';
import AppCta from '../components/AppCta.astro';
import DotGrid from '../components/DotGrid.astro';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Two faithful layouts share these components; CSS shows one per breakpoint.
const PLAY_URL = 'https://play.google.com/store/apps/details?id=club.streaq.app';
const APP_URL = 'https://app.streaq.club';
const KICKER = 'Now on Android';
const PLAY_CTA = 'Get it on Google Play';
const WEB_CTA = 'Open in browser';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Streaq: Streaks worth keeping"
      description="Track your habits on Streaq, share them with the friends who keep you honest, and watch the days stack up. Get the Android app on Google Play, or use Streaq in your browser."
      previewDescription="Track your habits, share them with the friends who keep you honest, and watch the days stack up. Now on Google Play, and on the web."
      path="/"
    />
  </head>

  <body>
    <div class="screen">
    <!-- ── Desktop · centered editorial ── -->
    <main class="layout-desktop">
      <div class="dt-glow" aria-hidden="true"></div>

      <header class="dt-topbar">
        <BrandLockup size={30} />
        <ThemeToggle />
      </header>

      <section class="dt-center">
        <div class="dt-eyebrow"><Eyebrow size={12}>{KICKER}</Eyebrow></div>
        <h1 class="dt-h1">Streaks worth <em>keeping.</em></h1>
        <p class="dt-p">
          Track your habits, share them with the friends who keep you honest, and watch
          the days stack up. The Android app is live on Google Play, or start your first
          streak right in your browser.
        </p>
        <AppCta
          playHref={PLAY_URL}
          playCta={PLAY_CTA}
          webHref={APP_URL}
          webCta={WEB_CTA}
        />
      </section>

      <div class="dt-band"><DotGrid rows={4} cols={17} dot={17} gap={14} /></div>
    </main>

    <!-- ── Mobile · split stack ── -->
    <main class="layout-mobile">
      <div class="mb-glow" aria-hidden="true"></div>

      <header class="mb-header">
        <BrandLockup size={26} />
        <ThemeToggle />
      </header>

      <section class="mb-hero">
        <div class="mb-eyebrow"><Eyebrow size={11}>{KICKER}</Eyebrow></div>
        <h1 class="mb-h1">Streaks worth <em>keeping.</em></h1>
        <p class="mb-p">
          Track your habits, share them with the friends who keep you honest, and watch
          the days stack up. Now on Google Play.
        </p>
        <div class="mb-motif"><DotGrid rows={4} cols={9} dot={16} gap={11} /></div>
      </section>

      <div class="mb-cta">
        <AppCta
          playHref={PLAY_URL}
          playCta={PLAY_CTA}
          webHref={APP_URL}
          webCta={WEB_CTA}
        />
      </div>
    </main>

    <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* breakpoint: desktop ≥ 721px, mobile ≤ 720px */
  .layout-desktop {
    display: block;
  }
  .layout-mobile {
    display: none;
  }
  @media (max-width: 720px) {
    .layout-desktop {
      display: none;
    }
    .layout-mobile {
      display: flex;
    }
  }

  /* Hero and footer together fill exactly one screen: the hero takes
     whatever height the footer leaves. */
  .screen {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  /* ── desktop ── */
  .layout-desktop {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
  .dt-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 520px;
    height: 520px;
    border-radius: 520px;
    background: radial-gradient(circle, oklch(0.58 0.11 220 / 0.16), transparent 70%);
    pointer-events: none;
    display: none;
  }
  :global([data-theme='dark']) .dt-glow {
    display: block;
  }
  .dt-topbar {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(24px, 4vh, 40px) 60px;
  }
  .dt-center {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 56px;
    margin-top: clamp(16px, 6vh, 70px);
  }
  .dt-eyebrow {
    margin-bottom: 28px;
  }
  .dt-h1 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    font-size: 96px;
    margin: 0;
    max-width: 900px;
    color: var(--fg);
    text-wrap: balance;
  }
  .dt-h1 em {
    font-style: italic;
    font-weight: 500;
  }
  .dt-p {
    font-size: 21px;
    line-height: 1.5;
    color: var(--sub);
    max-width: 560px;
    margin: 28px 0 42px;
    text-wrap: pretty;
  }
  .dt-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    padding-bottom: 50px;
  }

  /* On wide screens, lay the desktop column out in normal flow: .dt-center
     (flex:1) pushes the dot band to the bottom on tall viewports, and on short
     ones the band sits below the content (with breathing room) so the page
     scrolls instead of the dots colliding with the hero. Scoped to ≥721px so it
     never overrides the mobile `display:none` from the breakpoint above. */
  @media (min-width: 721px) {
    .layout-desktop {
      display: flex;
      flex-direction: column;
    }
    .dt-center {
      flex: 1;
    }
    .dt-band {
      position: static;
      padding: clamp(24px, 5vh, 56px) 0 clamp(24px, 4vh, 50px);
    }
  }

  /* ── mobile ── */
  /* On phones the hero gets the whole first screen (svh: measured with the
     browser's toolbars showing) and the footer sits below it. Squeezing both
     into one phone screen left no room to breathe. Spacing steps: 16/24/32/40. */
  .layout-mobile {
    position: relative;
    flex-direction: column;
    flex: none;
    min-height: 100svh;
    padding: 14px 28px clamp(24px, 5svh, 40px);
    overflow: hidden;
  }
  .mb-glow {
    position: absolute;
    top: 60px;
    right: -70px;
    width: 240px;
    height: 240px;
    border-radius: 240px;
    background: radial-gradient(circle, oklch(0.58 0.11 220 / 0.2), transparent 70%);
    pointer-events: none;
    display: none;
  }
  :global([data-theme='dark']) .mb-glow {
    display: block;
  }
  .mb-header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mb-hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding: clamp(16px, 4svh, 32px) 0;
  }
  .mb-eyebrow {
    margin-bottom: 16px;
  }
  .mb-h1 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    font-size: 42px;
    margin: 0;
    color: var(--fg);
  }
  .mb-h1 em {
    font-style: italic;
    font-weight: 500;
  }
  .mb-p {
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--sub);
    margin: 24px 0 clamp(24px, 5svh, 40px);
    text-wrap: pretty;
  }
  .mb-motif {
    display: flex;
    justify-content: center;
  }
  .mb-cta {
    position: relative;
  }
</style>
