---
// Shared <head> contents for every page: meta, canonical, link previews,
// fonts, and the pre-paint theme script. Pages pass their own title,
// description and path; og:image must stay an absolute URL (scrapers
// require it).
interface Props {
  title: string;
  description: string;
  /** Path on streaq.club, e.g. "/" or "/manifesto". */
  path: string;
  /** Shorter description for link previews; defaults to `description`. */
  previewDescription?: string;
}
const { title, description, path, previewDescription = description } = Astro.props;
const SITE = 'https://streaq.club';
const url = new URL(path, SITE).href;
const image = `${SITE}/og.png`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#edeae3" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Streaq" />
<meta property="og:title" content={title} />
<meta property="og:description" content={previewDescription} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="2400" />
<meta property="og:image:height" content="1260" />
<meta property="og:image:alt" content="Streaq: streaks worth keeping" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={previewDescription} />
<meta name="twitter:image" content={image} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
  rel="stylesheet"
/>

<!-- Set the theme before paint to avoid a flash. Defaults to light. -->
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('streaq-theme');
      document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>
